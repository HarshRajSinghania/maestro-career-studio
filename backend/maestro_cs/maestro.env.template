# Read by `maestro start`. Keep it private.
# One KEY=value per line; remove the leading # to turn a line on. An empty value counts as unset.
# Get API keys from this machine's own secret store, never from a chat.
# Restart Maestro (`maestro restart`) after you change this file.

# Model provider. Leave all empty to use Maestro without AI features.
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENROUTER_API_KEY=
# Point at an OpenAI-compatible server (Ollama, LM Studio, vLLM) to keep resume text on this machine.
#OPENAI_BASE_URL=
#FAST_MODEL=
#SMART_MODEL=
#CHAT_MODEL=

# If a proxy decrypts TLS, set these here.
#HTTPS_PROXY=http://proxy.example:3128
#NO_PROXY=127.0.0.1,localhost
#SSL_CERT_FILE=

# Always-on copy only: the laptop's address. No path and no query.
# Sync is on when the file `sync-key` exists in this folder; never put the key itself in this file.
#SYNC_REMOTE_URL=http://127.0.0.1:8101

# Leave these unless two copies run side by side; the Companion and sync expect 8001 and 3000.
#MAESTRO_PORT=8001
#MAESTRO_WEB_PORT=3000
